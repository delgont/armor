{
    "name": "delgont/armor",
    "description": "Armor is a high‑performance Laravel package for managing user roles and permissions. It provides a flexible, cache‑friendly system to define, assign, and enforce permissions across your application, making route and action protection seamless and efficient.",
    "keywords": [
        "laravel admin",
        "laravel user permissions",
        "laravel user roles", 
        "laravel dashboard package",
        "Delgont authenticator",
        "Laravel who are you"
    ],
    "homepage": "https://github.com/delgont/armor",
    "type" : "project",
    "license" : "MIT",
    "authors" : [
        {
            "name" : "Stephen Okello Omoding",
            "email" : "okellostephenomoding@gmail.com",
            "role" : "Developer"
        },
        {
            "name" : "Stephen Delgont",
            "email" : "stephen.delgont@outlook.com",
            "role" : "Project Manager, Developer"
        }
    ],
    "require": {
        "php": "^7.2.5 || ^8.0",
        "illuminate/support": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "illuminate/auth": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "illuminate/database": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "laravel/helpers": "^1.5.0 || 1.6.0 || 1.7.0"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Delgont\\Armor\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Delgont\\Armor\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Delgont\\Armor\\ArmorServiceProvider"
            ]
        }
    }
}