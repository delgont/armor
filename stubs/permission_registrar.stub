<?php

namespace {{ namespace }};

use Delgont\Armor\PermissionRegistrar;

class {{ class }} extends PermissionRegistrar
{
    /**
     * The group these permissions belong to.
     * Group names are unique, so give each registrar its own.
     */
    protected $group = '{{ group }}';

    /*
     * Every string constant in this class becomes a permission when you run
     * `php artisan armor:permissions:sync`. Do not add helper constants.
     *
     * Values are snake_case: can_<verb>_<resource>. They are unique across
     * ALL groups, and renaming one later creates a new permission, so pick
     * names you can live with.
     *
     * const CAN_VIEW_USERS = 'can_view_users';
     */

    /**
     * Descriptions keyed by permission value, shown in admin screens.
     */
    protected function descriptions(): array
    {
        return [
            // self::CAN_VIEW_USERS => 'View the list of users.',
        ];
    }
}